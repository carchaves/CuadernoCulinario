{
  "name": "cocina-app-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build:app": "npm run build -w app",
    "android:build": "cd android-native && ./gradlew assembleDebug",
    "android:install": "adb install -r android-native/app/build/outputs/apk/debug/app-debug.apk",
    "android:run": "npm run android:build && npm run android:install && adb shell am start -n dev.raflos.cocina/.MainActivity"
  }
}
